<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- DVR（NVMS-9000）只提供明文 HTTP / ws://，必須允許非 HTTPS 連線 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- Sparkle 自動更新：更新清單（appcast）與 EdDSA 公鑰（私鑰存在開發者鑰匙圈，帳號 local.dvrviewer.app） -->
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/doghsiao412/mac-dvr-viewer/main/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>D+7J9EE0lB9lUT48/hNNpy4fjTpGxII3C/YpLRF2vF4=</string>
	<!-- 預設開啟自動檢查（不再於第二次啟動時詢問）；使用者可在設定頁關閉 -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>NSLocalNetworkUsageDescription</key>
	<string>DVR Viewer 需要連線到區域網路內的 DVR／NVR 以觀看即時影像與錄影。</string>
</dict>
</plist>
